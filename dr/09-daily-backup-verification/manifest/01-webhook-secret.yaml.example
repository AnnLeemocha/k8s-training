# =============================================================================
# 09-daily-backup-verification / manifest/01-webhook-secret.yaml.example
# 通知用 webhook URL（Slack Incoming Webhook / Mattermost / Google Chat 皆可接受 {"text": ...}）。
# 副檔名 .yaml.example：`kubectl apply -f manifest/` 會略過它。建立方式：
#
#   kubectl -n dr-ops create secret generic backup-notify \
#     --from-literal=WEBHOOK_URL='https://hooks.slack.com/services/XXX/YYY/ZZZ'
#
# 不建立這個 Secret 也可以：CronJob 設定為 optional，通知只會印在 Job log。
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: backup-notify
  namespace: dr-ops
type: Opaque
stringData:
  WEBHOOK_URL: https://hooks.slack.com/services/請替換
