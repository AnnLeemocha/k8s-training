<mxfile host="app.diagrams.net" agent="k8s-training">
  <diagram id="onlyoffice-arch" name="onlyoffice K8s Architecture">
    <mxGraphModel dx="1007" dy="560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="uUyLT6_sTeZ5LCkORuDQ-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=light-dark(#A8CCFC,#507BAD);strokeColor=#999999;dashed=1;fontStyle=1;opacity=30;" value="K8S Cluster" vertex="1">
          <mxGeometry height="850" width="1190" x="200" y="50" as="geometry" />
        </mxCell>
        <mxCell id="client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="學員瀏覽器" vertex="1">
          <mxGeometry height="60" width="140" x="40" y="490" as="geometry" />
        </mxCell>
        <mxCell id="nsDefault" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=light-dark(#A8CCFC,#507BAD);strokeColor=light-dark(#595858,#EDEDED);dashed=1;fontStyle=1;opacity=30;strokeWidth=2;" value="namespace: default (shared-infra)" vertex="1">
          <mxGeometry height="140" width="220" x="220" y="290" as="geometry" />
        </mxCell>
        <mxCell id="gateway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="dev-gateway&#xa;(Gateway API / Cilium)&#xa;http :80 + https :443" vertex="1">
          <mxGeometry height="70" width="170" x="245" y="330" as="geometry" />
        </mxCell>
        <mxCell id="nsOnlyoffice" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=light-dark(#A8CCFC,#507BAD);strokeColor=light-dark(#595858,#EDEDED);dashed=1;fontStyle=1;opacity=30;strokeWidth=2;" value="namespace: onlyoffice" vertex="1">
          <mxGeometry height="760" width="850" x="500" y="90" as="geometry" />
        </mxCell>
        <mxCell id="rq" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" value="ResourceQuota + LimitRange&#xa;(namespace 資源治理，實測用量遠低於官方建議 2CPU/4GB)" vertex="1">
          <mxGeometry height="70" width="280" x="560" y="150" as="geometry" />
        </mxCell>
        <mxCell id="secret" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Secret: onlyoffice-secret&#xa;JWT_SECRET" vertex="1">
          <mxGeometry height="70" width="200" x="525" y="590" as="geometry" />
        </mxCell>
        <mxCell id="route" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="HTTPRoute: onlyoffice&#xa;host: onlyoffice.nexai.org.com" vertex="1">
          <mxGeometry height="60" width="190" x="520" y="335" as="geometry" />
        </mxCell>
        <mxCell id="svc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Service: onlyoffice&#xa;ClusterIP :80 -&gt; :80" vertex="1">
          <mxGeometry height="60" width="180" x="525" y="495" as="geometry" />
        </mxCell>
        <mxCell id="deploy" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#f8f8f8;strokeColor=#666666;fontStyle=1;" value="Deployment: onlyoffice (replicas=1)" vertex="1">
          <mxGeometry height="360" width="330" x="870" y="270" as="geometry" />
        </mxCell>
        <mxCell id="pod1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Pod&#xa;onlyoffice/documentserver:latest&#xa;:80&#xa;（內建 nginx/docservice/&#xa;postgres/redis/rabbitmq，&#xa;皆非獨立 K8s 資源）" vertex="1">
          <mxGeometry height="140" width="230" x="915" y="320" as="geometry" />
        </mxCell>
        <mxCell id="pluginsNote" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=10;" value="⚠️ PLUGINS_ENABLED=false：預設會嘗試連 github.com 下載外掛，&#xa;被 NetworkPolicy 擋掉會卡在重試迴圈、吃滿 ~1 核 CPU" vertex="1">
          <mxGeometry height="80" width="170" x="1160" y="340" as="geometry" />
        </mxCell>
        <mxCell id="pvc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="PVC: onlyoffice-data&#xa;/var/www/onlyoffice/Data&#xa;(RWO, rook-ceph-block)&#xa;log/lib 用 emptyDir" vertex="1">
          <mxGeometry height="80" width="230" x="915" y="510" as="geometry" />
        </mxCell>
        <mxCell id="np" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="NetworkPolicy&#xa;default-deny + 放行 Gateway ingress :80 / DNS egress :53&#xa;+ egress → filebrowser namespace :80（雙向整合）" vertex="1">
          <mxGeometry height="70" width="620" x="525" y="730" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="client" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="gateway">
