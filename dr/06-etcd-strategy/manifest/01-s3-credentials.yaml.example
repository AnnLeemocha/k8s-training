# =============================================================================
# 06-etcd-strategy / 01-s3-credentials.yaml.example
# etcd snapshot 上傳 S3 用的帳密（範本）。副檔名刻意是 .yaml.example：`kubectl apply -f manifest/`
# 會略過它，避免用佔位字串覆蓋掉線上真正的 Secret。請改用下面的 kubectl create 指令建立。
#
#   kubectl -n etcd-backup create secret generic etcd-backup-s3-credentials \
#     --from-literal=AWS_ACCESS_KEY_ID=etcd-backup \
#     --from-literal=AWS_SECRET_ACCESS_KEY='<secret>'
#
# 建議：在 SeaweedFS s3-config.json 另建一個 identity，只給 etcd-backups bucket 的
# Read/Write/List 權限，不要跟 Velero 共用帳號。
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: etcd-backup-s3-credentials
  namespace: etcd-backup
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: etcd-backup              # SeaweedFS 上 etcd 備份專用帳號
  AWS_SECRET_ACCESS_KEY: <請填入>              # 不要把真正的值 commit 進 Git
