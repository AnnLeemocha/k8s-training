          <mxGeometry x="1140" y="640" width="260" height="200" as="geometry" />
        </mxCell>
        <mxCell id="podDb" value="Pod&#10;postgres:16.4-alpine&#10;（entrypoint 需 root，不 drop capabilities）&#10;PGDATA=/var/lib/postgresql/data/pgdata&#10;:5432" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
