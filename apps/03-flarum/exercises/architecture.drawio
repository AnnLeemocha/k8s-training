<mxfile host="app.diagrams.net" modified="2026-09-22T00:00:00.000Z" agent="k8s-training" version="24.7.17" type="device">
  <diagram id="flarum-arch" name="flarum K8s Architecture">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Client -->
        <mxCell id="client" value="學員瀏覽器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- default namespace group -->
        <mxCell id="nsDefault" value="namespace: default (shared-infra)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#999999;dashed=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="480" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="gateway" value="dev-gateway&#10;(Gateway API / Cilium)&#10;http :80 + https :443" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="285" y="520" width="170" height="70" as="geometry" />
        </mxCell>

        <!-- flarum namespace group -->
        <mxCell id="nsFlarum" value="namespace: flarum" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#999999;dashed=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="40" width="980" height="1100" as="geometry" />
        </mxCell>

        <mxCell id="rq" value="ResourceQuota + LimitRange&#10;(namespace 資源治理，max 要同時容納&#10;flarum + mysql 兩邊的 limits)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="80" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="route" value="HTTPRoute: flarum&#10;host: flarum.nexai.org.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="590" y="520" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="svcFlarum" value="Service: flarum&#10;ClusterIP :80 -&gt; :8888" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="840" y="520" width="190" height="60" as="geometry" />
        </mxCell>

        <!-- flarum Deployment group -->
        <mxCell id="deployFlarum" value="Deployment: flarum (replicas=1, strategy=Recreate)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#f8f8f8;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="140" width="400" height="420" as="geometry" />
        </mxCell>
        <mxCell id="initC" value="initContainer: init-storage-dirs&#10;busybox：mkdir + chown 991:991&#10;（本課程第一個 initContainer）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1130" y="180" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="podFlarum" value="Pod: flarum&#10;mondedie/flarum:latest :8888&#10;enableServiceLinks: false&#10;（避免 FLARUM_PORT 環境變數撞名）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1130" y="280" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pvcStorage" value="PVC: flarum-storage&#10;RWO / rook-ceph-block&#10;掛載 /flarum/app/storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1130" y="400" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pvcAssets" value="PVC: flarum-assets&#10;RWX / rook-cephfs&#10;掛載 /flarum/app/public/assets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1310" y="400" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="secFlarum" value="Secret: flarum-secret&#10;FLARUM_ADMIN_PASS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1130" y="620" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="secMysql" value="Secret: mysql-secret&#10;MYSQL_ROOT_PASSWORD / MYSQL_DATABASE&#10;MYSQL_USER / MYSQL_PASSWORD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1360" y="620" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="svcMysql" value="Service: mysql (Headless)&#10;clusterIP: None :3306" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1130" y="740" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- mysql StatefulSet group -->
        <mxCell id="ssMysql" value="StatefulSet: mysql (replicas=1)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#f8f8f8;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="850" width="400" height="220" as="geometry" />
        </mxCell>
        <mxCell id="podMysql" value="Pod: mysql-0&#10;mysql:8.0.40 :3306&#10;livenessProbe initialDelaySeconds=60&#10;（首次 initdb 實測近 97 秒才 ready）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1130" y="890" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pvcMysql" value="PVC (volumeClaimTemplate): data&#10;RWO / rook-ceph-block /var/lib/mysql" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1130" y="1000" width="340" height="50" as="geometry" />
        </mxCell>

        <!-- NetworkPolicy boundary -->
        <mxCell id="np" value="NetworkPolicy（同 namespace podSelector-to-podSelector，共 6 條）&#10;default-deny-all + 只放行 Gateway→flarum:8888、&#10;flarum→mysql:3306、DNS:53、cloudbeaver→mysql:3306（跨 ns）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="960" width="480" height="90" as="geometry" />
