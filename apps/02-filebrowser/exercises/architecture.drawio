          <mxGeometry x="560" y="40" width="880" height="900" as="geometry" />
        </mxCell>

        <mxCell id="rq" value="ResourceQuota + LimitRange&#10;(含 requests.storage / PVC 數量配額)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="80" width="250" height="60" as="geometry" />
