          <mxGeometry x="1135" y="430" width="190" height="90" as="geometry" />
        </mxCell>

        <mxCell id="pvcSrv" value="PVC: filebrowser-srv&#10;ReadWriteMany（RWX）&#10;rook-cephfs / 10Gi&#10;掛載 /srv（檔案本體）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
