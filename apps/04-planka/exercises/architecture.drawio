        <mxCell id="svcDb" value="Service: postgres (Headless)&#10;clusterIP: None :5432" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="860" y="700" width="200" height="60" as="geometry" />
