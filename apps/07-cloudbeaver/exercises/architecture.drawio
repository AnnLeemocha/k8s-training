        <mxCell id="rq" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" value="ResourceQuota + LimitRange&#xa;(namespace 資源治理)" vertex="1">
