        <mxCell id="route" value="HTTPRoute: planka&#10;host: planka.nexai.org.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="590" y="480" width="200" height="60" as="geometry" />
        </mxCell>

