          <mxGeometry x="1140" y="400" width="260" height="180" as="geometry" />
        </mxCell>
        <mxCell id="podApp" value="Pod&#10;ghcr.io/plankanban/planka:latest&#10;非 root (uid 1000)，無 initContainer&#10;capabilities drop: ALL&#10;:1337" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1165" y="440" width="210" height="110" as="geometry" />
