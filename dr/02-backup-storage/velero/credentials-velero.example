# =============================================================================
# credentials-velero.example — Velero 連 S3 的認證檔範本（AWS credentials 格式）
#
# 用法：
#   cp credentials-velero.example credentials-velero   # 真正的檔案不要進版控！
#   vi credentials-velero                               # 填入 SeaweedFS 的 velero 帳號
#   velero install ... --secret-file ./credentials-velero
#   （或事後更新：見 README「更換 credentials」）
#
# 帳號來源：seaweedfs/README.md「建立正式服務」建立的 velero identity
#   - 權限限定在 velero bucket（Read/Write/List/Tagging:velero）
#   - 不能建立 bucket → bucket 由管理者事先用 seaweed-admin 建立
# =============================================================================
[default]
aws_access_key_id=velero-backup
aws_secret_access_key=<請填入 SeaweedFS s3-config.json 中 velero 的 secretKey>
