        </mxCell>
        <mxCell id="pvc" value="PVC: data&#10;RWO, rook-ceph-block, 5Gi&#10;（子目錄 pgdata 避開 ext4 lost+found）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1165" y="850" width="210" height="80" as="geometry" />
